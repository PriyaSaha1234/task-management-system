# Port the API server listens on
PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/taskmanagement?schema=public"

# Secret used to sign JWT tokens - change this to a long random string
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Allowed browser origins (comma separated) - the user frontend and the admin site
CLIENT_URLS="http://localhost:5173,http://localhost:5174"

# Initial admin account created by `npm run seed`
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@taskmanager.com"
ADMIN_PASSWORD="change_me_to_a_strong_password"
